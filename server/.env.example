# Spotify Web API — server-side only. Powers the #my-taste section: ONE
# authenticated identity (the site owner), fetched and cached server-side,
# served to every visitor as read-only display content. Visitors never
# authenticate. See README.md's "iTunes vs Spotify" section for the full
# architecture split.

# From https://developer.spotify.com/dashboard — this app's Client ID/Secret.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Must exactly match a Redirect URI registered on the Spotify app. As of
# Spotify's Nov 27 2025 OAuth migration, bare "localhost" hostnames are
# rejected — local dev must use the loopback IP literal 127.0.0.1 instead,
# and production must be HTTPS (loopback is the only exception to that).
# e.g. http://127.0.0.1:5050/callback locally, https://api.diegodamian.com/callback in prod.
SPOTIFY_REDIRECT_URI=

# Long-lived token minted once via /login -> /callback (see README). Lets the
# server mint fresh access tokens on its own from then on, no login required.
SPOTIFY_REFRESH_TOKEN=

# Required, no default in code. Currently https://api.spotify.com/v1
SPOTIFY_API_BASE_URL=

# Shared secret gating /login (visit /login?key=<this value> to re-auth).
# Without it set, /login is open to anyone who finds the URL — fine for local
# dev, never leave unset in production.
SPOTIFY_LOGIN_SECRET=

# Where /callback sends the browser back to after a successful re-auth.
FRONTEND_BASE_URL=http://localhost:5173
# This server's own public URL. Only used server-side (logs); never sent to visitors.
BACKEND_BASE_URL=http://localhost:5050

# Comma-separated CORS allowlist override. Defaults to the hardcoded
# production + local-dev origins in server.js if left unset.
# ALLOWED_ORIGINS=https://diegodamian.com,https://www.diegodamian.com,http://localhost:5173

PORT=5050
