    "deny": [
      "Bash(rm -rf /:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fdx:*)",
      "Bash(npm publish:*)",
      "Bash(railway down:*)",
      "Bash(curl:*api.resend.com*)"
